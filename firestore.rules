rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('membershipStatus', 'approved') == 'approved';
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true;
    }

    // Brother profiles: any signed-in brother can read (needed to show names on
    // announcements/events/comments). A brother manages their own doc; admins
    // can edit anyone's (that's their "change info on other accounts" power)
    // and can disable accounts. isAdmin/disabled are protected fields a normal
    // brother can never set on themselves. Admin grants are server-managed.
    function authorityOwner() {
      return get(/databases/$(database)/documents/organization/adminAuthority).data.ownerUid;
    }
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isSignedIn();
      allow create: if false; // Only the server approval workflow creates profiles.
      allow update: if isSignedIn()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['big','bigName','bigPledgeName','littles','littlePledgeNames','little','littleName','littleNames','bigId','littleIds','id','disabled','deletionRequestedAt','accountStatusUpdatedAt','accountStatusUpdatedBy','uid','email','membershipStatus','isAdmin','leadershipBaseAdmin','adminAccessOverride','leadershipTitles','nationalTitle','chapterPresident','alumniAdvisor','membershipStanding'])
        && (!(resource.data.get('isAdmin', false) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled'])) || (request.auth.uid == authorityOwner() && uid != authorityOwner()))
        && (isAdmin() || (request.auth.uid == uid && resource.data.get('disabled', false) != true && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['disabled'])));
      allow delete: if false; // Account deletion must run through the audited server cleanup.
    }

    // Announcements go through admin approval: non-admins can only create with
    // approved == false (a pending request), admins create approved == true
    // directly. Only admins may ever change the approved field — an author
    // editing their own post can touch anything except it.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid
        && (request.resource.data.get('approved', false) == false || (request.resource.data.get('approved', false) == true && isAdmin()));
      allow update: if isSignedIn() && (
        isAdmin()
        || (resource.data.authorUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved','authorUid','createdByUid']))
      );
      allow delete: if isSignedIn() && (resource.data.authorUid == request.auth.uid || isAdmin());

      // Delete is also allowed for the announcement's own author and admins,
      // not just the comment's author — deleting an announcement cascades to
      // delete every comment underneath it (see deleteAnnouncementCascade),
      // including ones the announcement author didn't write themselves.
      match /comments/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorUid']);
        allow delete: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          get(/databases/$(database)/documents/announcements/$(id)).data.authorUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Events follow the same approval flow as announcements.
    match /events/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid
        && (request.resource.data.get('approved', false) == false || (request.resource.data.get('approved', false) == true && isAdmin()));
      allow update: if isSignedIn() && (
        isAdmin()
        || (resource.data.createdByUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved','authorUid','createdByUid']))
      );
      allow delete: if isSignedIn() && (resource.data.createdByUid == request.auth.uid || isAdmin());

      // RSVP doc ID must equal the writer's own uid for create/update — you can
      // only ever set your own RSVP. Delete is also allowed for the event's
      // owner and admins, since deleting an event cascades to delete every RSVP
      // under it (see deleteEventCascade), including other brothers' RSVPs.
      match /rsvps/{rsvpUid} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn() && request.auth.uid == rsvpUid;
        allow delete: if isSignedIn() && (
          request.auth.uid == rsvpUid ||
          get(/databases/$(database)/documents/events/$(id)).data.createdByUid == request.auth.uid ||
          isAdmin()
        );
      }

      // Same cascade-delete reasoning as announcements/{id}/comments above.
      match /comments/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
        allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorUid']);
        allow delete: if isSignedIn() && (
          resource.data.authorUid == request.auth.uid ||
          get(/databases/$(database)/documents/events/$(id)).data.createdByUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Pledge classes + the pledges within them: every brother can read (this
    // is brotherhood history, not private), but only admins can create or
    // change any of it.
    match /pledgeClasses/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();

      match /pledges/{pledgeId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isAdmin();
      }

      // Photos & videos: unlike the rest of a pledge class, any signed-in
      // brother can add media (not just admins) — this is a shared photo
      // album. Only the uploader or an admin can delete an item. The actual
      // file bytes live in Cloud Storage (see storage.rules); this doc is
      // just the gallery entry (download URL + who/when).
      match /media/{mediaId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uploadedByUid == request.auth.uid;
        allow update: if isSignedIn() && (resource.data.uploadedByUid == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption','taggedUids','updatedAt'])
          && request.resource.data.caption is string && request.resource.data.caption.size() <= 1000
          && request.resource.data.taggedUids is list && request.resource.data.taggedUids.size() <= 30
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSignedIn() && (resource.data.uploadedByUid == request.auth.uid || isAdmin());
      }
    }

    // Family tree: lineage (who picked up whom) across every chapter and
    // year. Every brother can read; only admins can add, edit, or delete
    // nodes. bigId points at the parent node's doc id, or is absent/null
    // for a lineage root.
    match /familyTree/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Member Education: what a pledge needs in their notebook to cross,
    // broken into sections (e.g. "Rules"). Every brother can read; only
    // admins can add, edit, or delete sections.
    match /memberEducation/{sectionId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Gallery: photo albums any brother can start and add pics to — fully
    // visible to every signed-in brother, no per-album privacy. Renaming or
    // deleting an album is limited to whoever created it (or an admin); the
    // denormalized coverUrl/photoCount on the album doc can be bumped by
    // whoever's adding a photo, since anyone can add to any album. The
    // actual image bytes live in Cloud Storage (see storage.rules); each
    // photo doc here is just the gallery entry (download URL + who/when).
    match /galleryAlbums/{albumId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coverUrl', 'coverThumbUrl', 'photoCount', 'updatedAt'])
        || resource.data.createdByUid == request.auth.uid
        || isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.createdByUid == request.auth.uid || isAdmin());

      match /photos/{photoId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uploadedByUid == request.auth.uid;
        allow update: if isSignedIn() && (resource.data.uploadedByUid == request.auth.uid || get(/databases/$(database)/documents/galleryAlbums/$(albumId)).data.createdByUid == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption','taggedUids','updatedAt'])
          && request.resource.data.caption is string && request.resource.data.caption.size() <= 1000
          && request.resource.data.taggedUids is list && request.resource.data.taggedUids.size() <= 30
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSignedIn() && (resource.data.uploadedByUid == request.auth.uid || get(/databases/$(database)/documents/galleryAlbums/$(albumId)).data.createdByUid == request.auth.uid || isAdmin());
      }
    }

    // Blog: admin-authored posts shown publicly on the main website. A
    // published post is readable by anyone, signed in or not — that's what
    // powers the public blog page. Drafts/hidden posts are only readable by
    // admins (from the portal's Blog tab). Only admins can write at all.
    match /blogPosts/{postId} {
      allow read: if resource.data.status == 'published' || (isSignedIn() && isAdmin());
      allow create, update, delete: if isSignedIn() && isAdmin();
    }

    // Chapter link pages (nualphaphi.com/alpha, /beta, ... /kappa) — a
    // Linktree-style page per chapter, doc id is the chapter name. Fully
    // public read (that's the whole point — it replaces a Linktree link in
    // an Instagram bio). Only admins can create/delete a chapter's doc or
    // change who's an editor; an admin OR a listed editor can update
    // anything else (profile text, avatar, links) on their chapter(s).
    match /chapterLinktrees/{chapter} {
      allow read: if true;
      allow create, delete: if isSignedIn() && isAdmin();
      allow update: if isSignedIn() && (
        isAdmin()
        || (request.auth.uid in resource.data.get('editorUids', [])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editorUids']))
      );
    }

    // Outgoing email queue, consumed by the Firebase "Trigger Email" extension
    // (which reads with admin privileges, bypassing these rules). Portal
    // clients only ever enqueue; nobody can read the queue back.
    match /mail/{id} {
      allow create: if isAdmin();
      allow read, update, delete: if false;
    }

    // Comment notifications: the commenter (actor) creates the doc for the
    // post owner (recipient). Only the recipient can read their own
    // notifications, and their only allowed write is flipping `read`.
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.actorUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }

    // Forms (Google-Forms-style): the owner (createdByUid) can fully manage
    // the form, including who's listed in collaboratorUids. A form doc can
    // also be read by anyone, signed in or not, once published == true — that
    // public GET is what powers the public "fill out this form" link. List
    // queries (the portal's "My Forms" / "Shared with Me") still require
    // sign-in and are scoped per-document to owner/collaborator by the same
    // rule, same pattern as /notifications above.
    match /forms/{formId} {
      // resource == null first: a GET on a form id that doesn't exist (bad/typo'd
      // public link) has nothing to protect, and must short-circuit to true
      // before the other clauses touch resource.data — otherwise accessing
      // .data on a null resource throws and the whole rule denies, which
      // surfaces to visitors as a permission error instead of "not found".
      allow read: if resource == null
        || (resource.data.published == true && (resource.data.get('requireSignIn', false) != true || isSignedIn()))
        || (isSignedIn() && (
          resource.data.createdByUid == request.auth.uid ||
          (resource.data.collaboratorUids is list && request.auth.uid in resource.data.collaboratorUids)
        ));
      allow create: if isSignedIn() && request.resource.data.createdByUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.createdByUid == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdByUid','responseCount']);
      allow delete: if isSignedIn() && resource.data.createdByUid == request.auth.uid;

      // Responses: anyone (including unauthenticated visitors via the public
      // link) can submit a response while the form is published, unless the
      // owner turned on requireSignIn — then only a signed-in brother can.
      // Only the form's owner or collaborators can read the responses back.
      match /responses/{responseId} {
        allow create: if get(/databases/$(database)/documents/forms/$(formId)).data.get('version', 0) == 0
          && get(/databases/$(database)/documents/forms/$(formId)).data.get('onePerAccount', false) == false
          && get(/databases/$(database)/documents/forms/$(formId)).data.get('identified', false) == false
          && get(/databases/$(database)/documents/forms/$(formId)).data.get('closesAt', null) == null
          && get(/databases/$(database)/documents/forms/$(formId)).data.get('responseLimit', null) == null
          && get(/databases/$(database)/documents/forms/$(formId)).data.published == true
          && (get(/databases/$(database)/documents/forms/$(formId)).data.get('requireSignIn', false) != true || isSignedIn());
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/forms/$(formId)).data.createdByUid == request.auth.uid ||
          (get(/databases/$(database)/documents/forms/$(formId)).data.collaboratorUids is list &&
            request.auth.uid in get(/databases/$(database)/documents/forms/$(formId)).data.collaboratorUids)
        );
        allow update: if false;
        // Delete is only for the form's owner, mirroring who can delete the form
        // itself — needed so deleteFormCascade can clear out responses when a
        // form (which may have responses from other brothers) gets deleted.
        allow delete: if isSignedIn() && get(/databases/$(database)/documents/forms/$(formId)).data.createdByUid == request.auth.uid;
      }
    }

    // App-specific membership checks. Legacy portal permissions above are unchanged.
    function isSocialMember() { return isSignedIn(); }
    function isSocialAdmin() {
      return isSocialMember() && isAdmin();
    }

// Master roster is separate from accounts and family-tree records.
function rosterClassValid(d) {
  return d.keys().hasOnly(['chapter','pledgeClass','semesterCrossed','yearCrossed'])
    && ((!('semesterCrossed' in d) && !('yearCrossed' in d))
      || (d.get('semesterCrossed', '') in ['Spring','Summer','Fall','Winter']
        && d.get('yearCrossed', 0) is int && d.get('yearCrossed', 0) >= 1994 && d.get('yearCrossed', 0) <= 2100))
    && d.chapter in ['Alpha','Beta','Gamma','Delta','Epsilon','Zeta','Eta','Theta','Iota','Kappa']
    && d.pledgeClass is string && d.pledgeClass.size() > 0 && d.pledgeClass.size() <= 80;
}
match /masterRosterClasses/{id} {
  allow read: if isSocialMember();
  allow create, update: if isSocialAdmin() && rosterClassValid(request.resource.data);
  allow delete: if isSocialAdmin();
}
match /rosterTreeLinks/{id} {
  allow read: if isSocialMember();
  allow create, update: if isSocialAdmin()
    && exists(/databases/$(database)/documents/masterRoster/$(id))
    && request.resource.data.keys().hasOnly(['treeID','updatedBy','updatedAt'])
    && request.resource.data.treeID is string
    && request.resource.data.treeID.matches('^[A-Za-z0-9_-]{1,128}$')
    && exists(/databases/$(database)/documents/familyTree/$(request.resource.data.treeID))
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt == request.time;
  allow delete: if isSocialAdmin();
}

match /masterRoster/{id} {
  allow read: if isSocialMember();
  allow create, update: if isSocialAdmin()
    && request.resource.data.keys().hasOnly(['classID','pledgeName','fullName','disaffiliated','sourcePage','fallen','pledgeNumber','sortOrder','bio','location','occupation','email','phone'])
    && request.resource.data.get('bio','') is string && request.resource.data.get('bio','').size() <= 2000
    && request.resource.data.get('location','') is string && request.resource.data.get('location','').size() <= 200
    && request.resource.data.get('occupation','') is string && request.resource.data.get('occupation','').size() <= 200
    && request.resource.data.get('email','') is string && request.resource.data.get('email','').size() <= 200
    && request.resource.data.get('phone','') is string && request.resource.data.get('phone','').size() <= 200
    && request.resource.data.classID is string
    && existsAfter(/databases/$(database)/documents/masterRosterClasses/$(request.resource.data.classID))
    && request.resource.data.pledgeName is string && request.resource.data.pledgeName.size() > 0 && request.resource.data.pledgeName.size() <= 100
    && request.resource.data.fullName is string && request.resource.data.fullName.size() > 0 && request.resource.data.fullName.size() <= 200
    && request.resource.data.disaffiliated is bool
    && request.resource.data.get('fallen', false) is bool
    && request.resource.data.get('pledgeNumber', '') is string
    && request.resource.data.get('pledgeNumber', '').matches('^[0-9]{0,2}$')
    && request.resource.data.get('sortOrder', 0) is int && request.resource.data.get('sortOrder', 0) >= 0 && request.resource.data.get('sortOrder', 0) <= 10000
    && request.resource.data.sourcePage is int && request.resource.data.sourcePage >= 0 && request.resource.data.sourcePage <= 10000;
  allow delete: if isSocialAdmin();
}

match /organization/{document} { allow read: if isSocialMember(); allow write: if false; }
match /leadershipAudit/{id} { allow read: if isAdmin(); allow write: if false; }
match /membershipApplications/{uid} {
  allow read: if request.auth != null && (request.auth.uid == uid || isSocialAdmin());
  allow write: if false;
}
match /membershipNotices/{uid} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow write: if false;
}
match /membershipMail/{id} {
  allow read, write: if false;
}

match /postStatistics/{postId} {
  allow read: if isSocialMember();
  allow write: if false;
}

match /contentReports/{id} {
  allow read: if isSocialAdmin();
  allow write: if false;
}
match /accountDeletionJobs/{uid} { allow read, write: if false; }
match /announcementRequests/{id} {
  allow read: if isSocialMember() && (isSocialAdmin() || resource.data.authorUid == request.auth.uid);
  allow write: if false;
}

match /forumPosts/{postId} {
  allow read: if isSocialMember();
  allow create: if isSocialMember()
    && request.resource.data.keys().hasAll(['authorUid','authorName','chapter','body','createdAt'])
    && request.resource.data.keys().hasOnly(['authorUid','authorName','chapter','body','createdAt','photoPath','mentionIds','mentionChapters','kind','eventDate'])
    && validMentions()
    && request.resource.data.get('kind', 'post') in ['post','announcement','event']
    && (request.resource.data.get('kind', 'post') == 'post' || (request.resource.data.get('kind', 'post') == 'announcement' && isSocialAdmin()) || (request.resource.data.get('kind', 'post') == 'event' && socialGrant().get('role', '') == 'nationalBoard'))
    && (request.resource.data.get('kind', 'post') != 'event' || request.resource.data.eventDate is timestamp)
    && request.resource.data.authorUid == request.auth.uid
    && request.resource.data.authorName is string && request.resource.data.authorName.size() > 0 && request.resource.data.authorName.size() <= 200
    && request.resource.data.chapter is string && request.resource.data.chapter.size() <= 100
    && request.resource.data.body is string && request.resource.data.body.size() <= 2000
    && request.resource.data.get('photoPath', '') is string
    && (request.resource.data.body.size() > 0 || request.resource.data.get('photoPath', '') != '')
    && (request.resource.data.get('photoPath', '') == '' || request.resource.data.photoPath == 'postPhotos/' + postId + '/' + request.auth.uid + '.jpg')
    && request.resource.data.createdAt == request.time;
  allow update: if false;
  allow delete: if isSocialMember() && resource.data.get('eventID', '') == '' && (resource.data.authorUid == request.auth.uid || isSocialAdmin());
  match /likes/{uid} {
    allow read: if isSocialMember();
    allow create: if isSocialMember() && request.auth.uid == uid
      && exists(/databases/$(database)/documents/forumPosts/$(postId))
      && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    allow delete: if isSocialMember() && request.auth.uid == uid;
  }
  match /replies/{rid} {
    allow read: if isSocialMember() && exists(/databases/$(database)/documents/forumPosts/$(postId));
    allow create: if isSocialMember() && exists(/databases/$(database)/documents/forumPosts/$(postId))
      && request.resource.data.keys().hasOnly(['senderUid','senderName','body','createdAt','mentionIds','mentionChapters','replyToID'])
      && validMentions()
      && (request.resource.data.get('replyToID', '') == '' || (request.resource.data.replyToID is string && request.resource.data.replyToID.matches('^[A-Za-z0-9_-]{1,128}$') && exists(/databases/$(database)/documents/forumPosts/$(postId)/replies/$(request.resource.data.replyToID))))
      && request.resource.data.senderUid == request.auth.uid && request.resource.data.senderName is string
      && request.resource.data.senderName.size() <= 200
      && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
      && request.resource.data.createdAt == request.time;
    allow delete: if isSocialMember() && (resource.data.senderUid == request.auth.uid || isSocialAdmin());
  }
}

function socialGrant() {
  return get(/databases/$(database)/documents/socialAccess/$(request.auth.uid)).data;
}
function circleRole(g, roles) {
  return g.get('role', '') in roles || g.get('roles', []).hasAny(roles);
}
function channelAllowed(room) {
  let g = exists(/databases/$(database)/documents/socialAccess/$(request.auth.uid)) ? get(/databases/$(database)/documents/socialAccess/$(request.auth.uid)).data : {};
  let active = g.get('status', '') == 'active';
  return isSocialMember() && (
    room in ['general','shitposting','gaming','sports','finance']
    || (g.get('chapter', '') != '' && (
      room == 'chapter-' + g.chapter
      || (active && room == 'chapter-actives-' + g.chapter)
      || (!active && room == 'chapter-alumni-' + g.chapter)))
    || (g.get('term', '') in ['fall','spring','summer'] && g.get('year', '') != '' && room == 'pbs-' + g.term + '-' + g.year)
    || (room == 'leadership' && circleRole(g, ['president','nationalBoard','nationalIntern']))
    || (room == 'nationals' && circleRole(g, ['nationalBoard']))
    || (room == 'nationals-interns' && circleRole(g, ['nationalBoard','nationalIntern']))
    || (room == 'alumni-advisors' && circleRole(g, ['alumniAdvisor','nationalBoard','nationalIntern']))
    || (room == 'pledge-leadership' && circleRole(g, ['pledgeMaster','pledgeWarden']))
    || (room == 'actives' && active)
    || (room == 'alumni' && !active)
  );
}
function conversationMember(room) {
  return isSocialMember() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(room)).data.memberIds;
}
function validMessage(root, room, mid) {
  let d = request.resource.data;
  return d.keys().hasOnly(['senderUid', 'senderName', 'body', 'photoPath', 'createdAt', 'reactions', 'mentionIds','mentionChapters', 'replyToID', 'sharedPostID'])
    && validMentions()
    && d.senderUid == request.auth.uid && d.senderName is string && d.senderName.size() <= 200
    && d.body is string && d.body.size() <= 2000 && d.photoPath is string
    && (d.body.size() > 0 || d.photoPath != '' || d.get('sharedPostID', '') != '')
    && validChatReference(root, room)
    && (d.get('sharedPostID', '') == '' || (root == 'chatPhotos' && d.sharedPostID is string && d.sharedPostID.matches('^[A-Za-z0-9_-]{1,128}$') && exists(/databases/$(database)/documents/forumPosts/$(d.sharedPostID))))
    && (d.photoPath == '' || d.photoPath == root + '/' + room + '/' + mid + '/' + request.auth.uid + '.jpg')
    && d.createdAt == request.time && d.reactions == {};
}
function validChatReference(root, room) {
  let id = request.resource.data.get('replyToID', '');
  return id == '' || (id is string && id.matches('^[A-Za-z0-9_-]{1,128}$') &&
    ((root == 'channelPhotos' && exists(/databases/$(database)/documents/socialChannels/$(room)/messages/$(id))) ||
     (root == 'chatPhotos' && exists(/databases/$(database)/documents/conversations/$(room)/messages/$(id)))));
}
function ownReactionOnly() {
  let next = request.resource.data;
  return next.diff(resource.data).affectedKeys().hasOnly(['reactions'])
    && next.reactions is map
    && next.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid])
    && next.reactions.get(request.auth.uid, '') in ['', '❤️', '😂', '🔥', '👍', '🤝', '😮', '😢', '😡'];
}
match /socialAccess/{uid} {
  allow read: if isSocialMember() && (request.auth.uid == uid || isSocialAdmin());
  allow create, update: if isSocialAdmin()
    && request.resource.data.keys().hasOnly(['chapter','term','year','status','role','roles'])
    && request.resource.data.chapter in ['', 'Alpha','Beta','Gamma','Delta','Epsilon','Zeta','Eta','Theta','Iota','Kappa']
    && request.resource.data.term in ['', 'spring','summer','fall']
    && request.resource.data.year is string
    && (request.resource.data.year == '' || request.resource.data.year.matches('^[0-9]{4}$'))
    && request.resource.data.get('status', '') in ['', 'active','alumni']
    && request.resource.data.get('role', '') in ['', 'president','pledgeMaster','pledgeWarden','nationalBoard','nationalIntern','alumniAdvisor'];
  allow delete: if isSocialAdmin();
}
match /socialChannels/{room}/messages/{mid} {
  allow read: if channelAllowed(room);
  allow create: if channelAllowed(room) && validMessage('channelPhotos', room, mid);
  allow update: if channelAllowed(room) && ownReactionOnly();
  allow delete: if channelAllowed(room) && (resource.data.senderUid == request.auth.uid || isSocialAdmin());
}
match /chatSettings/{uid}/rooms/{room} {
 allow read: if isSocialMember() && request.auth.uid == uid;
 allow create, update: if isSocialMember() && request.auth.uid == uid
   && request.resource.data.keys().hasOnly(['muted','shareReceipts'])
   && request.resource.data.get('muted',false) is bool && request.resource.data.get('shareReceipts',false) is bool;
}
match /conversations/{room} {
  match /readReceipts/{uid} {
    allow read: if conversationMember(room);
    allow create,update: if conversationMember(room) && request.auth.uid == uid
      && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
    allow delete: if isSocialMember() && request.auth.uid == uid;
  }
  // Reading a missing deterministic DM id is needed for race-safe creation.
  allow get: if isSocialMember() && (resource == null || request.auth.uid in resource.data.memberIds);
  allow list: if isSocialMember() && request.auth.uid in resource.data.memberIds;
  allow create: if isSocialMember()
    && request.resource.data.keys().hasOnly(['memberIds','title','kind','createdBy','createdAt'])
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time
    && request.resource.data.memberIds is list
    && request.resource.data.memberIds.size() >= 2 && request.resource.data.memberIds.size() <= 30
    && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
    && request.auth.uid in request.resource.data.memberIds
    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
    && ((request.resource.data.kind == 'direct' && request.resource.data.memberIds.size() == 2)
      || (request.resource.data.kind == 'group' && request.resource.data.memberIds.size() > 2));
  allow update: if conversationMember(room) && resource.data.kind == 'group'
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','avatarPath','updatedAt'])
    && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
    && request.resource.data.updatedAt == request.time
    && (request.resource.data.get('avatarPath','') == resource.data.get('avatarPath','')
      || request.resource.data.avatarPath.matches('^groupPhotos/' + room + '/' + request.auth.uid + '/[A-Za-z0-9_-]+[.]jpg$'));
  allow delete: if false;
  match /messages/{mid} {
    allow read: if conversationMember(room);
    allow create: if conversationMember(room) && unblockedDM(room) && validMessage('chatPhotos', room, mid);
    allow update: if conversationMember(room) && ownReactionOnly();
    allow delete: if conversationMember(room) && (resource.data.senderUid == request.auth.uid || isSocialAdmin());
  }
}

function validMentions() {
  return request.resource.data.get('mentionIds', []) is list
    && request.resource.data.get('mentionIds', []).size() <= 30
    && request.resource.data.get('mentionChapters', []) is list
    && request.resource.data.get('mentionChapters', []).size() <= 10
    && request.resource.data.get('mentionChapters', []).hasOnly(['Alpha','Beta','Gamma','Delta','Epsilon','Zeta','Eta','Theta','Iota','Kappa']);
}
function unblockedDM(room) {
  let d = get(/databases/$(database)/documents/conversations/$(room)).data;
  let other = d.memberIds[0] == request.auth.uid ? d.memberIds[1] : d.memberIds[0];
  return d.kind != 'direct' || (
    !exists(/databases/$(database)/documents/blocks/$(other)/members/$(request.auth.uid))
    && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid)/members/$(other)));
}
match /activity/{uid}/items/{item} {
  allow read: if isSocialMember() && request.auth.uid == uid;
  allow update: if isSocialMember() && request.auth.uid == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
    && request.resource.data.read == true;
}
match /rosterAccountLinks/{uid} { allow read: if isSocialMember(); allow write: if false; }
match /rosterProfileLinks/{id} { allow read: if isSocialAdmin(); allow write: if false; }
match /leadershipHistory/{uid}/entries/{entry} { allow read: if isSocialMember(); allow write: if false; }
match /notificationPreferences/{uid} {
  allow read: if isSocialMember() && request.auth.uid == uid;
  allow create, update: if isSocialMember() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['announcements','events','mentions','directMessages','groupMessages','replies','newPosts'])
    && request.resource.data.get('announcements', true) is bool
    && request.resource.data.get('events', true) is bool
    && request.resource.data.get('mentions', true) is bool
    && request.resource.data.get('directMessages', true) is bool
    && request.resource.data.get('groupMessages', true) is bool
    && request.resource.data.get('replies', true) is bool
    && request.resource.data.get('newPosts', false) is bool;
}
match /blocks/{uid}/members/{other} {
  allow read, delete: if isSocialMember() && request.auth.uid == uid;
  allow create: if isSocialMember() && request.auth.uid == uid && other != uid
    && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
}
match /pushDevices/{uid}/tokens/{device} {
  allow read, delete: if request.auth != null && request.auth.uid == uid;
  allow create, update: if isSocialMember() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['token','updatedAt'])
    && request.resource.data.token is string && request.resource.data.token.size() <= 4096
    && request.resource.data.updatedAt == request.time;
}
match /roomReads/{uid}/rooms/{room} {
  allow read: if isSocialMember() && request.auth.uid == uid;
  allow create, update: if isSocialMember() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
}

// Approximate area sharing: no device coordinates or location history accepted.
match /locationPreferences/{uid} {
  allow read: if request.auth != null && request.auth.uid == uid;
  allow create, update: if isSocialMember() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['enabled'])
    && request.resource.data.enabled is bool
    && (request.resource.data.enabled == true || !existsAfter(/databases/$(database)/documents/brotherLocations/$(uid)));
}
match /brotherLocations/{uid} {
  allow read: if isSocialMember();
  allow create, update: if isSocialMember() && request.auth.uid == uid
    && get(/databases/$(database)/documents/locationPreferences/$(uid)).data.enabled == true
    && request.resource.data.keys().hasOnly(['label','latitudeCell','longitudeCell','updatedAt'])
    && request.resource.data.label is string && request.resource.data.label.size() > 0 && request.resource.data.label.size() <= 240
    && request.resource.data.latitudeCell is int && request.resource.data.latitudeCell >= -4500 && request.resource.data.latitudeCell <= 4500
    && request.resource.data.longitudeCell is int && request.resource.data.longitudeCell >= -9000 && request.resource.data.longitudeCell <= 9000
    && request.resource.data.updatedAt == request.time;
  allow delete: if request.auth != null && request.auth.uid == uid;
}


function eventReviewer() { return isAdmin(); }
function eventVisible(d) {
  return isSocialMember() && (d.status == 'published' || d.hostUid == request.auth.uid || request.auth.uid in d.collaboratorIds || request.auth.uid in d.invitedIds || (d.status == 'pending' && eventReviewer()));
}
function eventHasRSVP(event) {
  return request.auth != null && exists(/databases/$(database)/documents/appEvents/$(event)/attendees/$(request.auth.uid))
    && get(/databases/$(database)/documents/appEvents/$(event)/attendees/$(request.auth.uid)).data.status in ['going','maybe','busy','waitlist'];
}
function eventOrganizer(d) { return d.hostUid == request.auth.uid || request.auth.uid in d.collaboratorIds; }
match /appEvents/{event} {
  allow read: if eventVisible(resource.data);
  allow write: if false;
  match /attendees/{uid} {
    allow read: if eventVisible(get(/databases/$(database)/documents/appEvents/$(event)).data)
      && (request.auth.uid == uid || eventHasRSVP(event));
    allow write: if false;
  }
  match /activity/{item} {
    allow read: if eventVisible(get(/databases/$(database)/documents/appEvents/$(event)).data)
      && (resource.data.kind == 'comment' || eventHasRSVP(event));
    allow write: if false;
  }
  match /guestLists/{uid} {
    allow read: if eventVisible(get(/databases/$(database)/documents/appEvents/$(event)).data)
      && (request.auth.uid == uid || eventOrganizer(get(/databases/$(database)/documents/appEvents/$(event)).data));
    allow write: if false;
  }
  match /tickets/{id} { allow read, write: if false; }
  match /ticketOwners/{uid} { allow read, write: if false; }
  match /checkins/{uid} { allow read, write: if false; }
  match /requests/{id} { allow read, write: if false; }
}
    match /libraryFolders/{id} { allow read: if isSocialMember(); allow write: if false; }
    match /libraryFiles/{id} { allow read: if isSocialMember(); allow write: if false; }

    function pollVisible(id) {
      let poll = get(/databases/$(database)/documents/polls/$(id)).data;
      return isSocialMember() && ((poll.scope == 'post' && exists(/databases/$(database)/documents/forumPosts/$(id))) ||
        (poll.scope == 'channel' && channelAllowed(poll.roomID) && exists(/databases/$(database)/documents/socialChannels/$(poll.roomID)/messages/$(id))));
    }
    match /polls/{id} {
      allow read: if pollVisible(id); allow write: if false;
      match /votes/{uid} { allow read: if pollVisible(id) && request.auth.uid == uid; allow write: if false; }
    }
    match /saved/{uid}/items/{id} {
      allow read, delete: if isSocialMember() && request.auth.uid == uid;
      allow create, update: if isSocialMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kind','target','title','createdAt'])
        && request.resource.data.kind in ['event','document']
        && request.resource.data.target is string && request.resource.data.target.matches('^[A-Za-z0-9_-]{1,128}$')
        && request.resource.data.title is string && request.resource.data.title.size() <= 300
        && request.resource.data.createdAt == request.time;
    }
    match /channelNotificationSettings/{id} {
      allow read, delete: if isSocialMember() && resource.data.uid == request.auth.uid;
      allow create, update: if isSocialMember()
        && request.resource.data.keys().hasOnly(['uid','roomID','mode'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.roomID is string
        && request.resource.data.roomID.matches('^[A-Za-z0-9_-]{1,128}$')
        && id == request.auth.uid + '__' + request.resource.data.roomID
        && request.resource.data.mode in ['all','mentions','none'];
    }
    match /channelMutes/{uid}/rooms/{room} {
      allow read, delete: if isSocialMember() && request.auth.uid == uid;
      allow create, update: if isSocialMember() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
    }
    match /notificationControls/{uid} {
      allow read: if isSocialMember() && request.auth.uid == uid;
      allow create, update: if isSocialMember() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['quietEnabled','startMinute','endMinute','timeZone'])
        && request.resource.data.quietEnabled is bool && request.resource.data.startMinute is int
        && request.resource.data.startMinute >= 0 && request.resource.data.startMinute < 1440
        && request.resource.data.endMinute is int && request.resource.data.endMinute >= 0 && request.resource.data.endMinute < 1440
        && request.resource.data.timeZone is string && request.resource.data.timeZone.size() <= 100;
    }
    // All chapter operations access is mediated by operationsAction.
    match /chapterOperations/{chapter}/{document=**} {
      allow read, write: if false;
    }
  }
}
